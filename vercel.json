{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/prodentim%20reviews.html",
      "destination": "https://www.priodentim.com/reviews",
      "permanent": true
    },
    {
      "source": "/prodentim%20official%20website.html",
      "destination": "https://www.priodentim.com/official-website",
      "permanent": true
    },
    {
      "source": "/prodentim%20buy%20now.html",
      "destination": "https://www.priodentim.com/buy-now",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "priodentim.com"
        }
      ],
      "destination": "https://www.priodentim.com/:path*",
      "permanent": true
    }
  ]
}
